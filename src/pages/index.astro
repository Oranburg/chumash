---
// The home route: this week's aliyah. This used to be the single client-only
// island's default HashRouter route ("/"); it is now its own real static
// page, so the reader's very first response is a full, meaningful document
// (the shared chrome, the breadcrumb, the nav) with only the live,
// Sefaria-fetched aliyah body waiting on the ThisWeekScreen island below to
// mount and fetch.
import Layout from '../layouts/Layout.astro';
import ThisWeekScreen from '../screens/ThisWeekScreen.jsx';
---

<Layout title="Chumash: this week's aliyah" current="home" breadcrumbCurrent="Chumash">
  <ThisWeekScreen client:load />
</Layout>
